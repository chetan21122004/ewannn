# Canonical site origin for SEO, JSON-LD, and share metadata
VITE_SITE_URL=https://www.uvan.co.in

# Brevo - form submissions (local .env for npm run dev; Vercel env vars for production)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@uvan.co.in
BREVO_SENDER_NAME=UVAN Website

# Calendly event URL for Ask Soham booking (override in production if needed)
VITE_CALENDLY_SCHEDULING_URL=https://calendly.com/soham-uvan/30min

# Google Analytics 4 (optional override; default G-QQVY5K2K48)
VITE_GA_MEASUREMENT_ID=G-QQVY5K2K48
